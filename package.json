{
  "name": "about",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "View useful information about your Lumine installation.",
  "keywords": [
    "version",
    "release-notes",
    "credits",
    "license",
    "installation"
  ],
  "repository": "https://github.com/lumine-code/about",
  "bugs": {
    "url": "https://github.com/lumine-code/about/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "showOnStartup": {
      "title": "Show About On Startup",
      "description": "Show the About pane when opening a new Lumine window.",
      "type": "boolean",
      "default": true
    }
  },
  "deserializers": {
    "AboutView": "deserializeAboutView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#df06b3fca2ec49b1d6b76cb8af3e9f5015a2612c"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
